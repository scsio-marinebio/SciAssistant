# ----------------- Custom LLM Service Configuration -----------------
# [参数说明] 模型完整 Chat Completions URL；默认无，调用必填；取值为对应平台完整 HTTP(S) 接口地址。
MODEL_REQUEST_URL=
# [参数说明] 模型接口鉴权密钥；默认无；取值为平台签发 token，可带 Bearer 前缀；请勿分享。
MODEL_REQUEST_TOKEN
# [参数说明] 模型名/推理接入点 ID；环境未设置时实际为空，调用必填；取值以平台开放模型为准。例如：deepseek-v3.2、glm-5.1、zai-org/GLM-5.2、openpangu-72b
MODEL_NAME=
# [参数说明] 模型协议族；默认 auto 按模型名识别；常用 auto/pangu/deepseek/glm/openai_compatible；不决定显式思考格式。
MODEL_PROVIDER=
# [参数说明] 端点配置标识；默认 default；可选自由字符串，如 default/ark_agent_plan/siliconflow。
MODEL_API_PROFILE=
# [参数说明] 工具调用传输格式；默认 text；可选 text（文本工具协议）/native（原生 tools/tool_calls），按接入点能力选择。text=现有模型专用文本协议；native=OpenAI-compatible tools/tool_calls
MODEL_TOOL_CALL_MODE=text

# ----------------- pagu7B、openPangu72B 专用兼容开关 -----------------
# [参数说明] Pangu 自定义模板文本；可选自定义模板字符串，其他 provider 不使用，需注释掉，仅模型pagu7B、openPangu72B需要打开 MODEL_CHAT_TEMPLATE 配置。
MODEL_CHAT_TEMPLATE="{% for message in messages %}{% if loop.first and messages[0]['role'] != 'system' %}{{ '<s>[unused9]系统：[unused10]' }}{% endif %}{% if message['role'] == 'system' %}{{'<s>[unused9]系统：' + message['content'] + '[unused10]'}}{% endif %}{% if message['role'] == 'assistant' %}{{'[unused9]助手：' + message['content'] + '[unused10]'}}{% endif %}{% if message['role'] == 'tool' %}{{'[unused9]工具：' + message['content'] + '[unused10]'}}{% endif %}{% if message['role'] == 'function' %}{{'[unused9]方法：' + message['content'] + '[unused10]'}}{% endif %}{% if message['role'] == 'user' %}{{'[unused9]用户：' + message['content'] + '[unused10]'}}{% endif %}{% endfor %}{% if add_generation_prompt %}{{ '[unused9]助手：' }}{% endif %}"
# [参数说明] Pangu 自定义模板的特殊 token 间空格；默认未配置，自定义模板启用时实际 false；可选 true/false。
MODEL_SPACES_BETWEEN_SPECIAL_TOKENS=false
# ----------------- pangu_ultra_moe 专用兼容开关 -----------------
# [参数说明] 精确 pangu_ultra_moe 模型的兼容策略总开关；默认 false；可选 true/false。
PANGU_ULTRA_MOE_COMPAT_ENABLED=false
# [参数说明] Ultra 分类格式失败的额外重试次数；默认最多支持 1 次；可选非负整数，负值被钳制为 0。
PANGU_ULTRA_CLASSIFIER_MAX_FORMAT_RETRIES=1
# [参数说明] Ultra 分类修复采样温度；默认 0.0；可选模型支持的浮点数范围，建议保持默认以稳定输出格式。
PANGU_ULTRA_CLASSIFIER_TEMPERATURE=0.0
# [参数说明] Ultra 分类后程序驱动写作兜底；默认 false；可选 true/false，需总兼容开关启用。
PANGU_ULTRA_WRITER_FALLBACK_ENABLED=false
# [参数说明] Ultra Writer 允许调用次数；默认 2；可选正整数，最小按 1 处理。
PANGU_ULTRA_WRITER_MAX_INVOCATIONS=2
# [参数说明] Ultra 兜底每章最多选用文件数；默认 11；可选正整数，最小按 1 处理。
PANGU_ULTRA_FALLBACK_MAX_FILES_PER_CHAPTER=11
# [参数说明] Ultra 兜底每章额外重试次数；默认 1；可选非负整数，最小按 0 处理。
PANGU_ULTRA_FALLBACK_SECTION_RETRIES=1

# [参数说明] DeepSeek 程序驱动逐章写作；默认启用，仅 DeepSeek 生效；可选 true/false（开启还接受 1/yes/on）。
DEEPSEEK_PROGRAM_DRIVEN=false

# [参数说明] 单次模型 HTTP 请求超时秒数；默认 900；可选正整数，可被具体调用覆盖。
MODEL_REQUEST_TIMEOUT=1800
# [参数说明] 通用模型输出 token 预算；默认 8192；可选正整数且不得超出模型限制，章节等工具可能有单独预算。
MODEL_MAX_TOKENS=16384

# ----------------- MCP Server Configuration -----------------
# [参数说明] MCP 远程服务地址。
MCP_SERVER_URL=http://localhost:6274/mcp
# [参数说明] MCP 服务鉴权 token；默认无。
MCP_AUTH_TOKEN=
# [参数说明] MCP 通道选择；默认 true；可选 true（标准输入输出）/false（远程 HTTP 通道）。
MCP_USE_STDIO=true

# ----------------- Agent Iteration Limits -----------------
# [参数说明] Planner 迭代次数配置。
PLANNER_MAX_ITERATION=20
# [参数说明] 检索 Agent 迭代次数配置。
INFORMATION_SEEKER_MAX_ITERATION=35
# [参数说明] Writer 迭代次数配置。
WRITER_MAX_ITERATION=30
# [参数说明] Planner 工作模式；可选 auto/writing/qa。
PLANNER_MODE=writing

# ----------------- Search Engine Configuration -----------------
# [参数说明] 搜索服务地址；默认无；取值为搜索网关 HTTP(S) 地址。
SEARCH_ENGINE_BASE_URL=https://google.serper.dev/search
# [参数说明] 搜索鉴权密钥；默认无；可选单个 key 或英文逗号分隔多个 key（轮换），请勿分享。
SEARCH_ENGINE_API_KEYS=

# -----------------Webpage Fetch Configuration -----------------
# [参数说明] 网页正文提取服务地址；默认无；取值为配置的提取网关 HTTP(S) 地址。
URL_CRAWLER_BASE_URL=https://r.jinaai.cn
# [参数说明] 网页提取服务密钥；默认无；可选单个 key 或英文逗号分隔多个 key，请勿分享。
URL_CRAWLER_API_KEYS=
# [参数说明] 网页提取 token 预算；默认 100000；可选服务支持范围内的正整数。
URL_CRAWLER_MAX_TOKENS=100000

# ----------------- Tool Trajectory and Output Paths -----------------
# [参数说明] 轨迹存储配置路径；默认 ./workspace。
TRAJECTORY_STORAGE_PATH=./workspace
# [参数说明] 报告目录配置；默认 ./report。
REPORT_OUTPUT_PATH=./report
# [参数说明] 文档分析目录；默认 ./doc_analysis。
DOCUMENT_ANALYSIS_PATH=./doc_analysis

# ----------------- RAG Knowledge Base Configuration -----------------
# [参数说明] 知识库 API 地址；默认无；启用 RAG 时设置实际 HTTP(S) 服务地址。
RAG_API_URL=
# [参数说明] 知识库鉴权应用码；默认无；取值为服务端签发字符串，请勿分享。
RAG_APP_CODE=
# [参数说明] 默认知识库仓库 ID；默认无；取值为当前 RAG 服务有效仓库标识。
RAG_DEFAULT_REPO_ID=
# [参数说明] RAG 搜索默认每页数量；默认 20；可选服务支持的正整数。
RAG_DEFAULT_PAGE_SIZE=20
# [参数说明] 是否全局启用 RAG 搜索源；默认 true；可选 true/false。
SEARCH_SOURCE_RAG=false

# ----------------- General Settings -----------------
# [参数说明] 调试开关；默认 false；可选 true/false，开启会增加诊断输出。
DEBUG_MODE=true
# [参数说明] 通用重试/模型尝试次数配置；默认 3。
MAX_RETRIES=3
# [参数说明] 通用服务超时秒数（如搜索/网页提取）；默认 30；可选正整数，模型请求主要使用 MODEL_REQUEST_TIMEOUT。
TIMEOUT=45
# [参数说明] 显式请求格式；默认未设置；可选 enable_thinking/thinking/chat_template_enable_thinking/chat_template_think，按目标服务支持的参数格式选择。
MODEL_THINKING_FORMAT=chat_template_think
# [参数说明] 思考模式；未设置时不主动发送开关；可选 enabled/disabled/auto/default；default 不发开关，auto 仅 thinking 格式支持且需模型支持。
MODEL_THINKING_MODE=default
# [参数说明] 思考强度，独立于开关；默认不传；程序可选 minimal/low/medium/high/xhigh/max，实际支持依平台模型；不可搭配 disabled。
#MODEL_REASONING_EFFORT=low
