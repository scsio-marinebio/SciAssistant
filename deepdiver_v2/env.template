# ===================================
# DeepDiver 环境变量模板
# ===================================
# 复制到 deepdiver_v2/config/.env，填写部署环境的地址、模型名和凭据。可选项保持注释表示未配置

# ================= 模型服务 =================
# 完整的 Chat Completions 接口地址（包含实际路由）。
MODEL_REQUEST_URL=
MODEL_REQUEST_TOKEN=
# 平台实际模型名称或推理接入点 ID，调用必填。
MODEL_NAME=your-model-name
# auto 按模型名识别；接入点 ID 不含模型名时请显式指定协议族。
# auto | pangu | deepseek | glm
MODEL_PROVIDER=auto
# 端点标识，自由字符串，如 default / ark_agent_plan / siliconflow。
MODEL_API_PROFILE=default
# text：模型专用文本工具协议；native：原生 tools/tool_calls。
# 默认 text；确认当前接入点与模型支持原生工具调用后再启用 native。
MODEL_TOOL_CALL_MODE=text

# ================= 显式思考配置（可选） =================
# 格式：enable_thinking | thinking | chat_template_enable_thinking | chat_template_think
# 按服务实际支持的请求字段选择，不按模型名或端点域名自动推断。
# MODEL_THINKING_FORMAT=thinking
# 模式：enabled | disabled | auto | default；default 或未设置时不主动发送开关。
# enabled/disabled/auto 必须配置格式；auto 仅 thinking 格式支持。
# MODEL_THINKING_MODE=enabled
# 强度：minimal | low | medium | high | xhigh | max；实际支持范围由服务决定。
# 独立于思考开关，未设置则不发送，不能与 disabled 搭配。
# MODEL_REASONING_EFFORT=low
# 旧版布尔开关，仅 Pangu 保留隐式 chat_template_kwargs.think 映射。
# 新部署优先使用上述显式配置，不要与新模式配置冲突。
# MODEL_THINK_MODE=true

# ================= Pangu 自定义模板（可选） =================
# 仅 Pangu 且模板非空时发送；服务端已管理模板时保持注释。
# MODEL_CHAT_TEMPLATE=替换为部署服务要求的完整模板字符串
# true/false；启用自定义模板且未设置本项时按 false 发送。
# MODEL_SPACES_BETWEEN_SPECIAL_TOKENS=false

# ================= pangu_ultra_moe 专用兼容 =================
# 仅 provider=pangu、模型名精确为 pangu_ultra_moe 且总开关开启时生效。
PANGU_ULTRA_MOE_COMPAT_ENABLED=false
# 分类器格式修复额外重试次数，实际限制为 0 或 1。
PANGU_ULTRA_CLASSIFIER_MAX_FORMAT_RETRIES=1
PANGU_ULTRA_CLASSIFIER_TEMPERATURE=0.0
# 分类失败后的程序驱动 Writer 兜底，需同时开启总兼容开关。
PANGU_ULTRA_WRITER_FALLBACK_ENABLED=false
# Writer 最多调用次数（最小 1）。
PANGU_ULTRA_WRITER_MAX_INVOCATIONS=2
# 兜底每章最多选用文件数（最小 1）。
PANGU_ULTRA_FALLBACK_MAX_FILES_PER_CHAPTER=11
# 兜底每章额外重试次数（最小 0）。
PANGU_ULTRA_FALLBACK_SECTION_RETRIES=1

# ================= DeepSeek 写作策略 =================
# 仅 DeepSeek 生效，默认启用程序驱动逐章写作；false 关闭。
DEEPSEEK_PROGRAM_DRIVEN=true

# ================= 模型请求参数 =================
# 以下与代码通用默认值一致，具体调用可能覆盖温度、token 预算或超时。
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=8192
# 单次模型 HTTP 请求超时，单位秒。
MODEL_REQUEST_TIMEOUT=900

# ================= Agent 迭代与模式 =================
PLANNER_MAX_ITERATION=40
INFORMATION_SEEKER_MAX_ITERATION=30
WRITER_MAX_ITERATION=40
# auto | writing | qa
PLANNER_MODE=writing

# ================= MCP 服务 =================
MCP_SERVER_URL=http://localhost:6274/mcp
MCP_AUTH_TOKEN=
# 模板使用 HTTP 服务；代码在未配置此项时默认使用 stdio。
MCP_USE_STDIO=false

# ================= 搜索与网页提取 =================
SEARCH_ENGINE_BASE_URL=
# 多个密钥可用英文逗号分隔以轮换。
SEARCH_ENGINE_API_KEYS=
URL_CRAWLER_BASE_URL=
URL_CRAWLER_API_KEYS=
URL_CRAWLER_MAX_TOKENS=100000

# ================= RAG 知识库 =================
# 接入知识库时填写实际服务地址、应用码和仓库 ID。
RAG_API_URL=
RAG_APP_CODE=
RAG_DEFAULT_REPO_ID=
RAG_DEFAULT_PAGE_SIZE=20
# 全局 RAG 搜索开关；默认 false，部署知识库时可改为 true。
SEARCH_SOURCE_RAG=false

# ================= 输出路径 =================
TRAJECTORY_STORAGE_PATH=./workspace
REPORT_OUTPUT_PATH=./report
DOCUMENT_ANALYSIS_PATH=./doc_analysis

# ================= 常规设置 =================
DEBUG_MODE=false
MAX_RETRIES=3
# 通用服务超时（秒）；模型请求使用 MODEL_REQUEST_TIMEOUT。
TIMEOUT=30
